{
  "servers": {
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-maps"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "YOUR_GOOGLE_MAPS_KEY"
      }
    },
    "weather": {
      "command": "npx",
      "args": [
        "-y",
        "@dangahagan/weather-mcp"
      ]
    }
  }
}